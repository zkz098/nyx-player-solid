{
  "name": "nyx-player-solid",
  "version": "0.1.0",
  "description": "NyxPlayer 的 SolidJS 重构版 —— 简洁美观的音乐播放器组件库",
  "keywords": [
    "astro",
    "audio",
    "hexo",
    "music",
    "player",
    "solidjs"
  ],
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style": "./dist/nyx-player.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --type-check . --fix",
    "lint:ci": "oxlint --type-aware --type-check .",
    "format": "oxfmt .",
    "format:ci": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "solid-element": "^1.9.2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@iconify/types": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@unocss/preset-icons": "^66.7.4",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^6.0.3",
    "unocss": "^66.7.4",
    "vite": "^8.1.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
