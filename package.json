{
  "name": "nyx-player-solid",
  "version": "0.1.7",
  "description": "NyxPlayer 的 SolidJS 重构版 —— 简洁美观的音乐播放器组件库",
  "keywords": [
    "astro",
    "audio",
    "hexo",
    "music",
    "player",
    "solidjs"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkz098/nyx-player-solid.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/nyx-player.js",
      "import": "./dist/ssr/index.js"
    },
    "./component": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/nyx-player.js",
      "import": "./dist/ssr/index.js"
    },
    "./custom-element": {
      "types": "./dist/custom-element.d.ts",
      "browser": "./dist/custom-element.js",
      "import": "./dist/custom-element.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "default": "./dist/nyx-player.css"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/clean-dist.mjs && pnpm run build:lib && pnpm run build:ssr && pnpm run build:css && pnpm run build:types && pnpm run build:assets && pnpm run build:check:ssr",
    "build:check:ssr": "node scripts/ssr-check.mjs",
    "build:lib": "vite build",
    "build:ssr": "vite build --config vite.ssr.config.ts",
    "build:css": "unocss \"src/**/*.{ts,tsx}\" -o dist/uno.css && node scripts/merge-css.mjs",
    "build:types": "tsc -p tsconfig.build.json && node scripts/ship-types.mjs",
    "build:assets": "node scripts/ship-assets.mjs",
    "preview": "vite preview",
    "docs:dev": "pnpm docs:demo && pnpm -F nyx-player-docs dev",
    "docs:demo": "node scripts/build-demo.mjs",
    "docs:build": "pnpm build && pnpm docs:demo && pnpm -F nyx-player-docs build",
    "docs:preview": "pnpm -F nyx-player-docs preview",
    "docs:check": "pnpm -F nyx-player-docs check",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --type-check . --fix",
    "lint:ci": "oxlint --type-aware --type-check .",
    "format": "oxfmt .",
    "format:ci": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "solid-element": "^1.9.2",
    "solid-js": "^1.9.15",
    "solid-transition-group": "^0.3.0"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@iconify/types": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.0.0",
    "@unocss/cli": "^66.7.4",
    "@unocss/preset-icons": "^66.7.4",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^6.0.3",
    "unocss": "^66.7.4",
    "vite": "^8.1.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
